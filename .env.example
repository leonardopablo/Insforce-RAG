# Server-side values used by the deployed RAG edge functions.
# The reserved InsForge values are injected by the platform.
INSFORGE_BASE_URL=https://your-project.region.insforge.app
API_KEY=server-only-insforge-api-key
OPENROUTER_API_KEY=server-only-openrouter-key
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
RAG_API_KEY=replace-with-a-long-random-value
